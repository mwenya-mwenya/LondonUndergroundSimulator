    <Name>PythonInferenceService</Name>
    <RootNamespace>PythonInferenceService</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="app\predictor_service.py" />
    <Compile Include="app\server.py" />
    <Compile Include="app\__init__.py" />
    <Compile Include="generated\__init__.py" />
    <Compile Include="train_model.py" />
    <Compile Include="generated\inference_pb2.py" />
    <Compile Include="generated\inference_pb2_grpc.py" />
